<!-- diagrams/system-architecture.drawio -->
<mxfile host="app.diagrams.net" agent="httpe-architecture" version="24.0.0">
  <diagram name="System Architecture" id="httpe-system-architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

